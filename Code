      <div className="relative z-10">
        <div className="bg-[#EFD4CA] px-4 pb-6 pt-4 text-[#5a3e36]">
          <div className="mb-3 flex items-center justify-between text-[11px] font-medium">
            <span>07:00</span>
            <div className="flex items-center gap-2">
              <span>◠</span>
              <span>▮▮▮</span>
            </div>
          </div>
          <div className="mt-2 text-center">
            <div className="text-5xl">🔥</div>
            <div className="text-5xl font-bold">{streakCount}</div>
            <p className="text-sm">Day Streak</p>
          </div>
          <p className="mt-3 text-center text-sm">This is your longest streak yet! Keep going 💛</p>
        </div>

        <div className="space-y-5 px-4 py-5">
          {!submitted ? (
            <div className="rounded-[16px] bg-[#5a3e36] p-5 text-white">
              <h2 className="mb-1 text-lg font-semibold">Today’s check-in</h2>
              <p className="mb-4 text-xs text-white/80">
                {lastChoices.length > 0
                  ? "Your questions changed based on what you focused on last time."
                  : "Answer a few gentle questions about today."}
              </p>
              {currentQuestions.map((item) => (
                <div key={item.key} className="mb-3 flex items-center justify-between">
                  <span className="text-sm">{item.label}</span>
                  <button
                    onClick={() => toggleCheck(item.key)}
                    className="flex h-6 w-6 items-center justify-center border-2 border-white"
                    type="button"
                  >
                    {checkin[item.key] ? "✓" : ""}
                  </button>
                </div>
              ))}
              <button
                onClick={submitCheckin}
                className="mt-2 w-full rounded-xl bg-white py-2 font-medium text-[#5a3e36]"
                type="button"
              >
                Submit
              </button>
            </div>
          ) : (
            <div className="rounded-[16px] bg-[#FFFCF8] p-5 text-center text-[#5a3e36] shadow">
              <p className="mb-2 text-lg font-semibold">{positiveMessages[messageIndex]}</p>
              <p className="text-sm">
                Read the resources page for more support on how to manage how you feel.
              </p>
              <div className="mt-4 flex gap-3">
                <button
