export default function WellbeingAppPrototype() {
  // --- Simple Sign-in state ---
  const [isSignedIn, setIsSignedIn] = useState(false);
  const [userName, setUserName] = useState("");
  const [nameInput, setNameInput] = useState("");
  const [authMode, setAuthMode] = useState<"login" | "signup">("login");
  const [emailInput, setEmailInput] = useState("");
  const [passwordInput, setPasswordInput] = useState("");

  const handleSignIn = () => {
    if (!emailInput.trim() || !passwordInput.trim()) return;

    localStorage.setItem("isSignedIn", "true");
    localStorage.setItem("userEmail", emailInput);
    setUserName(emailInput.split("@")[0]);
    setIsSignedIn(true);
  };

  const handleLogout = () => {
    localStorage.removeItem("isSignedIn");
    localStorage.removeItem("userName");
    setIsSignedIn(false);
    setUserName("");
    setNameInput("");
  };
  const [tab, setTab] = useState<MainTab>("home");
  const [subPage, setSubPage] = useState<SubPage>(null);
  const [accountPage, setAccountPage] = useState<AccountPage>(null);
  const [dayIndex, setDayIndex] = useState(3);
  const [currentQuestionSet, setCurrentQuestionSet] = useState(0);
  const [lastChoices, setLastChoices] = useState<string[]>([]);
  const [checkin, setCheckin] = useState<Record<string, boolean>>(() => {
    const today = new Date().toDateString();
    const savedDate = localStorage.getItem("trackDate");
    const savedCheckin = localStorage.getItem("trackCheckin");
    return savedDate === today && savedCheckin ? JSON.parse(savedCheckin) : {};
  });
  const [submitted, setSubmitted] = useState(() => {
    const today = new Date().toDateString();
    const savedDate = localStorage.getItem("trackDate");
    const savedSubmitted = localStorage.getItem("trackSubmitted");
    return savedDate === today && savedSubmitted === "true";
  });
  const [messageIndex, setMessageIndex] = useState(0);
  const [streakCount, setStreakCount] = useState(() => {
    const saved = localStorage.getItem("trackStreakCount");
    return saved ? Number(saved) : 0;
  });
  const [lastStreakDate, setLastStreakDate] = useState(() => localStorage.getItem("lastStreakDate") || "");
  const [completedDays, setCompletedDays] = useState<boolean[]>([
    true,
    true,
    true,
    false,
    false,
    false,
    false,
  ]);
  const [topImage, setTopImage] = useState<string | null>(null);
  const [bottomImage, setBottomImage] = useState<string | null>(null);
  const [journalSubmitted, setJournalSubmitted] = useState(() => {
  const today = new Date().toDateString();
  const savedDate = localStorage.getItem("journalDate");
  const savedCompleted = localStorage.getItem("journalCompleted");
  return savedDate === today && savedCompleted === "true";
});
  const [journalQuoteIndex, setJournalQuoteIndex] = useState(0);
  const [freeWriteText, setFreeWriteText] = useState(() => {
    const today = new Date().toDateString();
    const savedDate = localStorage.getItem("journalDate");
    return savedDate === today ? localStorage.getItem("freeWriteText") || "" : "";
  });
  const [dailyJournalText, setDailyJournalText] = useState("");
  const [weeklyJournalText, setWeeklyJournalText] = useState("");

  useEffect(() => {
    const today = new Date().toDateString();
    localStorage.setItem("trackDate", today);
    localStorage.setItem("trackCheckin", JSON.stringify(checkin));
    localStorage.setItem("trackSubmitted", submitted ? "true" : "false");
  }, [checkin, submitted]);

  useEffect(() => {
    localStorage.setItem("trackStreakCount", String(streakCount));
    if (lastStreakDate) {
      localStorage.setItem("lastStreakDate", lastStreakDate);
    } else {
      localStorage.removeItem("lastStreakDate");
    }
  }, [streakCount, lastStreakDate]);

  useEffect(() => {
    const todayKey = getDateKey();
    const yesterdayKey = getYesterdayDateKey();

    if (lastStreakDate && lastStreakDate !== todayKey && lastStreakDate !== yesterdayKey) {
      setStreakCount(0);
      setLastStreakDate("");
    }
  }, [lastStreakDate]);

  useEffect(() => {
    const resetJournalIfNewDay = () => {
      const today = new Date().toDateString();
      const savedDate = localStorage.getItem("journalDate");

      if (savedDate !== today) {
        setJournalSubmitted(false);
        setFreeWriteText("");
        setDailyJournalText("");
        setWeeklyJournalText("");
        localStorage.removeItem("journalDate");
        localStorage.removeItem("journalCompleted");
        localStorage.removeItem("freeWriteText");
      }
    };

    resetJournalIfNewDay();

    const now = new Date();
    const nextMidnight = new Date();
    nextMidnight.setHours(24, 0, 0, 0);
    const msUntilMidnight = nextMidnight.getTime() - now.getTime();

    const midnightTimeout = window.setTimeout(() => {
      // Reset journal
      setJournalSubmitted(false);
      setFreeWriteText("");
      setDailyJournalText("");
      setWeeklyJournalText("");

      // Reset check-in (TRACK PAGE)
      if (!submitted) {
        setStreakCount(0);
        setLastStreakDate("");
        localStorage.removeItem("trackStreakCount");
        localStorage.removeItem("lastStreakDate");
      }

      setCheckin({});
      setSubmitted(false);
      localStorage.removeItem("trackDate");
      localStorage.removeItem("trackCheckin");
      localStorage.removeItem("trackSubmitted");
    }, msUntilMidnight);

    return () => window.clearTimeout(midnightTimeout);
  }, []);

  const handleUpload = (e: ChangeEvent<HTMLInputElement>, type: "top" | "bottom") => {
    const file = e.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = () => {
      const result = typeof reader.result === "string" ? reader.result : null;
      if (!result) return;
      if (type === "top") setTopImage(result);
      else setBottomImage(result);
    };
    reader.readAsDataURL(file);
  };

  const questionSets = useMemo<Question[][]>(
    () => [
      [
        { key: "moved", label: "Moved my body" },
        { key: "meals", label: "Ate regular meals" },
        { key: "water", label: "Drank water" },
        { key: "sleep", label: "Slept okay" },
      ],
      [
        { key: "stretch", label: "Took a moment to stretch" },
        { key: "snack", label: "Had a nourishing snack or meal" },
        { key: "break", label: "Took a break when I needed one" },
        { key: "kind", label: "Spoke kindly to myself" },
      ],
      [
        { key: "outside", label: "Spent a little time outside" },
        { key: "water2", label: "Checked in with my hydration" },
        { key: "rest", label: "Let myself rest without guilt" },
        { key: "breathe", label: "Paused and took a few deep breaths" },
      ],
    ],
    []
  );

  const positiveMessages = useMemo(
    () => [
      "You showed up for yourself today 💛",
      "Small steps still count, and today mattered 🌷",
      "You cared for yourself today, and that is something to be proud of ✨",
      "Progress can be gentle. You are doing better than you think 💕",
    ],
    []
  );

  const journalQuotes = useMemo(
    () => [
      "Be proud of every small step you take 🌷",
      "Your body deserves kindness, care, and patience 💛",
      "You are growing at your own pace, and that is enough ✨",
      "Even on hard days, you are still doing beautifully 💕",
    ],
    []
  );

  const currentQuestions = questionSets[currentQuestionSet];

  const openMainTab = (nextTab: MainTab) => {
    setSubPage(null);
    setAccountPage(null);
    setTab(nextTab);
  };

  const toggleCheck = (key: string) => {
    if (submitted) return;
    setCheckin((prev) => ({ ...prev, [key]: !prev[key] }));
  };

  const submitCheckin = () => {
    if (submitted) return;

    const selectedKeys = Object.entries(checkin)
      .filter(([, value]) => value)
      .map(([key]) => key);

    const todayKey = getDateKey();
    const yesterdayKey = getYesterdayDateKey();

    setLastChoices(selectedKeys);
    setSubmitted(true);
    localStorage.setItem("trackDate", new Date().toDateString());
    localStorage.setItem("trackSubmitted", "true");
    setMessageIndex((prev) => (prev + 1) % positiveMessages.length);

    setStreakCount((prev) => {
      if (lastStreakDate === todayKey) return prev;
      if (lastStreakDate === yesterdayKey) return prev + 1;
      return 1;
    });
    setLastStreakDate(todayKey);

    setCompletedDays((prev) => {
      const next = [...prev];
      next[dayIndex] = true;
      return dayIndex === 6 ? [false, false, false, false, false, false, false] : next;
    });

    setCurrentQuestionSet((prev) => {
      if (
        selectedKeys.includes("moved") ||
        selectedKeys.includes("stretch") ||
        selectedKeys.includes("outside")
      ) {
        return 1;
      }
      if (
        selectedKeys.includes("meals") ||
        selectedKeys.includes("snack") ||
        selectedKeys.includes("water") ||
        selectedKeys.includes("water2")
      ) {
        return 2;
      }
      return (prev + 1) % questionSets.length;
    });

    setDayIndex((prev) => (prev === 6 ? 0 : prev + 1));
  };

  const submitJournal = () => {
    if (!dailyJournalText.trim() || !weeklyJournalText.trim()) return;

    const today = new Date().toDateString();
    localStorage.setItem("journalDate", today);
    localStorage.setItem("journalCompleted", "true");
    localStorage.setItem("freeWriteText", freeWriteText);

    setJournalSubmitted(true);
    setJournalQuoteIndex((prev) => (prev + 1) % journalQuotes.length);
  };

  const SignInScreen = () => (
    <div className="relative overflow-hidden rounded-[26px] pb-10 shadow-[0_8px_30px_rgba(0,0,0,0.08)]">
      <BackgroundBlobs />

      <div className="relative z-10">
        <FrameHeader title={authMode === "login" ? "Login" : "Sign Up"} dark />

        <div className="px-4 py-6">
          <div className="rounded-[22px] bg-[#FFFCF8] p-6 text-[#5a3e36] shadow">
            <h1 className="text-center text-xl font-semibold">
              {authMode === "login" ? "Welcome back" : "Create your account"}
            </h1>

            <div className="mt-5 space-y-3">
              <input
                type="email"
                value={emailInput}
                onChange={(e) => setEmailInput(e.target.value)}
                placeholder="Email"
                className="w-full rounded-xl border border-[#EFD4CA] bg-[#F4EBE2] px-4 py-3 outline-none"
              />

              <input
                type="password"
                value={passwordInput}
                onChange={(e) => setPasswordInput(e.target.value)}
                placeholder="Password"
                className="w-full rounded-xl border border-[#EFD4CA] bg-[#F4EBE2] px-4 py-3 outline-none"
              />

              {authMode === "signup" && (
                <input
                  type="text"
                  value={nameInput}
                  onChange={(e) => setNameInput(e.target.value)}
                  placeholder="Name"
                  className="w-full rounded-xl border border-[#EFD4CA] bg-[#F4EBE2] px-4 py-3 outline-none"
                />
              )}
            </div>

            <button
              onClick={handleSignIn}
              className="mt-5 w-full rounded-xl bg-[#5a3e36] py-3 text-white transition active:scale-95"
              type="button"
            >
              {authMode === "login" ? "Login" : "Sign Up"}
            </button>

            <button
              onClick={() => setAuthMode(authMode === "login" ? "signup" : "login")}
              className="mt-3 w-full text-sm text-[#5a3e36]"
              type="button"
            >
              {authMode === "login" ? "Don't have an account? Sign Up" : "Already have an account? Login"}
            </button>
          </div>
        </div>
      </div>
    </div>
  );

  const HomeScreen = () => (
    <div className="relative overflow-hidden rounded-[26px] pb-24 shadow-[0_8px_30px_rgba(0,0,0,0.08)]">
      <BackgroundBlobs />
      <div className="relative z-10">
        <div className="bg-[#EFD4CA] px-4 pb-5 pt-4">
          <div className="mb-3 flex items-center justify-between text-[11px] font-medium text-[#5a3e36]">
            <span>07:00</span>
            <div className="flex items-center gap-2">
              <span>◠</span>
              <span>▮▮▮</span>
            </div>
          </div>

          <div className="relative h-44 w-full overflow-hidden rounded-b-[18px] bg-[linear-gradient(135deg,#8d6c62_0%,#b08b7f_55%,#8b6b61_100%)]">
            {topImage ? (
              <img src={topImage} alt="Home hero" className="h-full w-full object-cover" />
            ) : null}
            <label className="absolute bottom-3 left-3 cursor-pointer rounded-full bg-[#FFFCF8]/95 px-3 py-1 text-[11px] font-medium text-[#5a3e36] shadow transition active:scale-95">
              Upload top image
              <input
                type="file"
                accept="image/*"
                onChange={(e) => handleUpload(e, "top")}
                className="hidden"
              />
            </label>
          </div>
        </div>

        <div className="px-4 py-5">
          <div className="rounded-[12px] bg-[#5a3e36] px-4 py-4 text-white shadow-sm">
            <p className="text-[20px] font-medium leading-tight">Hi {userName || "there"} 💛</p>
            <p className="mt-1 text-[18px] leading-snug">
              You are doing your best today, and that is enough.
            </p>
          </div>

          <div className="mt-4 text-right">
            <button
              onClick={() => openMainTab("support")}
              className="text-[14px] font-medium text-[#5a3e36]"
              type="button"
            >
              Show All
            </button>
          </div>

          <div className="mt-3 grid grid-cols-3 gap-4">
            {[
              { label: "Why?", page: "why" as const },
              { label: "What?", page: "what" as const },
              { label: "How?", page: "how" as const },
            ].map((button) => (
              <button
                key={button.label}
                onClick={() => {
                  setTab("support");
                  setSubPage(button.page);
                }}
                className="flex h-24 items-center justify-center rounded-[12px] bg-[#5a3e36] text-[18px] font-medium text-white shadow-sm transition active:scale-95"
                type="button"
              >
                {button.label}
              </button>
            ))}
          </div>

          <div className="mt-6 overflow-hidden rounded-[16px] bg-[#FFFCF8]/90 shadow backdrop-blur-sm">
            <div className="relative h-44 w-full">
              {bottomImage ? (
                <img src={bottomImage} alt="Home feature" className="h-full w-full object-cover" />
              ) : (
                <>
                  <div className="absolute inset-0 bg-gradient-to-br from-[#f5eee9] via-[#f0e6df] to-[#eaded6]" />
                  <div className="absolute left-4 right-4 top-3 text-center text-[#5a3e36]">
                    <p className="text-[18px] font-semibold leading-tight">Time to put</p>
                    <p className="-mt-1 text-[22px] font-semibold italic">yourself</p>
                    <p className="-mt-1 text-[18px] font-semibold">first.</p>
                  </div>
                  <div className="absolute inset-x-0 bottom-3 flex items-end justify-center">
                    <svg viewBox="0 0 220 120" className="h-28" aria-hidden="true">
                      <circle cx="110" cy="60" r="48" fill="#ead4da" />
                      <g stroke="#5a3e36" strokeWidth="3" fill="none" strokeLinecap="round">
                        <circle cx="100" cy="38" r="6" fill="#5a3e36" />
                        <path d="M100 44 L100 70" />
                        <path d="M100 70 L122 82 L138 82" />
                        <path d="M100 70 L80 86 L64 92" />
                        <path d="M100 48 C95 34, 92 28, 90 22" />
                        <path d="M100 48 C105 34, 108 28, 110 22" />
                      </g>
                    </svg>
                  </div>
                </>
              )}
              <label className="absolute bottom-3 left-3 cursor-pointer rounded-full bg-[#EFD4CA]/95 px-3 py-1 text-[11px] font-medium text-[#5a3e36] shadow transition active:scale-95">
                Upload bottom image
                <input
                  type="file"
                  accept="image/*"
                  onChange={(e) => handleUpload(e, "bottom")}
                  className="hidden"
                />
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>
  );

  const TrackScreen = () => (
    <div className="relative overflow-hidden rounded-[26px] pb-24 shadow-[0_8px_30px_rgba(0,0,0,0.08)]">
